NODE_ENV=production
APP_URL=https://leadmelo.example.com
# Local Docker on Windows/Linux binds the web UI to this host port (container still listens on 3000).
HOST_PORT=7676
# Isolate Compose networks/volumes per environment (leadmelo-dev vs leadmelo-prod).
COMPOSE_PROJECT_NAME=leadmelo
RELEASE_TAG=20.0.0
# Generate each password with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
# Distinct database names per environment; do not reuse a volume after changing this.
POSTGRES_DB=leadmelo
# For commands outside Docker, use the correct host and runtime credentials.
DATABASE_URL=postgresql://leadmelo_app:CHANGE_ME@postgres:5432/leadmelo
SESSION_SECRET=CHANGE_ME
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=CHANGE_ME
# Operator-owned HTTPS gateway implementing docs/PROVIDER_GATEWAY.md. LeadMelo refuses http://.
# For the bundled gateway (docker compose --profile gateway) this is the public HTTPS URL of your reverse
# proxy in front of 127.0.0.1:8788, for example https://gateway.example.com (see deploy/caddy, deploy/nginx).
PROVIDER_GATEWAY_URL=
# Directory holding tenants.json (and optional taxonomy.json) for the bundled gateway; keep mode 700/600.
# See gateway/README.md. It is mounted read-only into the gateway container only.
GATEWAY_CONFIG_DIR=./gateway-config
# Keep false until the live acceptance checklist passes.
OUTBOUND_ENABLED=false
# Optional operator-controlled HTTPS alert receiver; receives IDs/codes, not mail bodies.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Provisioning only; do not keep an initial password after bootstrap.
BOOTSTRAP_TENANT=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# --- Added in V20 growth release (all optional) ---
# Enforce plan limits (campaigns, seats, emails, prospects, experiments, trial expiry). Off by default so a
# self-hosted install is never throttled; set to "on" when you sell tiered plans.
PLAN_ENFORCEMENT=off
# Sender health is computed automatically from your own send/bounce data plus SPF/DMARC DNS checks.
# Set to "off" only if you feed health from an external source exclusively.
SENDER_HEALTH_AUTO=on

# --- Optional AI assist (bring your own model; configured per workspace in Settings > AI assist) ---
# Comma-separated hosts (host or host:port) that tenants may use over plain http or on a private network,
# for example a local Ollama: AI_ALLOWED_HOSTS=host.docker.internal:11434. Empty means public https only.
AI_ALLOWED_HOSTS=
# Maximum AI calls per workspace per rolling 24 hours.
AI_DAILY_LIMIT=200
